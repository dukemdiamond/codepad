# Production (Vercel): realtime sync through Liveblocks (free tier is plenty).
# Get a public key at https://liveblocks.io/dashboard/apikeys
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# Alternative to Liveblocks: point at your own y-websocket server
# (e.g. `npm run sync-server` deployed on Render/Fly/Railway).
# Leave both empty for local dev; it defaults to ws://<current host>:1234
NEXT_PUBLIC_YJS_WS_URL=
